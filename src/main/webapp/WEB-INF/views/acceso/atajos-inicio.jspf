<%@ page pageEncoding="UTF-8" %>
<c:set var="primeraAccion" value="${empty vistaInicio.buscador() ? 1 : 0}" />
<c:if test="${vistaInicio.accesos().size() gt primeraAccion}">
    <section class="panel-surface dashboard-actions" aria-labelledby="atajos-titulo">
        <div class="panel-surface-heading dashboard-block-heading">
            <span class="panel-mark"><svg class="panel-icon" aria-hidden="true"><use href="${iconos}#arrow" /></svg></span>
            <div><h2 id="atajos-titulo">Accesos rápidos</h2></div>
        </div>
        <ul>
            <c:forEach items="${vistaInicio.accesos()}" var="acceso" begin="${primeraAccion}">
                <c:url var="rutaAcceso" value="${acceso.ruta()}" />
                <li><a href="<c:out value='${rutaAcceso}' />">
                    <svg class="panel-icon" aria-hidden="true"><use href="${iconos}#${acceso.icono()}" /></svg>
                    <span><strong><c:out value="${acceso.titulo()}" /></strong><small><c:out value="${acceso.descripcion()}" /></small></span>
                    <svg class="panel-icon" aria-hidden="true"><use href="${iconos}#chevron" /></svg>
                </a></li>
            </c:forEach>
        </ul>
    </section>
</c:if>
